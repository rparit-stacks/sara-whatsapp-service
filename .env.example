# Copy to .env and fill in. In production the same names come from Doppler as real env vars.

# ---- Service ----
SERVER_PORT=8090
MONGODB_URI=mongodb://localhost:27017/sara_whatsapp
MONGODB_DATABASE=sara_whatsapp
# base64, 16/24/32 bytes: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=
# protects /v1/admin/** (create API clients, switch provider): openssl rand -hex 32
ADMIN_API_KEY=
WHATSAPP_PROVIDER=META
DEFAULT_COUNTRY_CODE=91

# ---- Meta WhatsApp Cloud API ----
META_GRAPH_VERSION=v24.0
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_APP_ID=
# any random string you choose; the same value goes into the Meta app webhook settings
META_WEBHOOK_VERIFY_TOKEN=

# ---- Optional ----
# Unique recipients a broadcast may start per rolling 24h. Match your Meta messaging limit (new accounts start at 250).
BROADCAST_DAILY_LIMIT=250
# Opened by GET /v1/usage/billing-link
META_BILLING_URL=https://business.facebook.com/billing_hub/
